type parts_app, domain;
typeattribute parts_app mlstrustedsubject;

app_domain(parts_app)

allow parts_app activity_service:service_manager find;
allow parts_app activity_task_service:service_manager find;
allow parts_app audio_service:service_manager find;
allow parts_app netstats_service:service_manager find;
allow parts_app vendor_hal_displayfeature_xiaomi_service:service_manager find;
binder_call(parts_app, vendor_hal_displayfeature_xiaomi_default)

allow parts_app system_app_data_file:dir create_dir_perms;
allow parts_app system_app_data_file:file create_file_perms;
allow parts_app system_app_data_file:lnk_file create_file_perms;

# Parts (XiaomiParts touch toggle drives both HTSR channels: proc node + touchfeature)
allow parts_app proc_touch_file:file rw_file_perms;

# Parts (HTSR ON asserts touchfeature GAME/ACTIVE=1, OFF resets them so a
# stale game session cannot keep the high rate)
allow parts_app hal_touchfeature_xiaomi_service:service_manager find;
binder_call(parts_app, hal_touchfeature_xiaomi_default)

# Parts (Back light effects, AW21024 RGB LED)
allow parts_app sysfs_leds_aw21024:dir search;
allow parts_app sysfs_leds_aw21024:file rw_file_perms;
allow parts_app sysfs_leds_aw21024:lnk_file rw_file_perms;
# Traverse /sys/class/leds parent for the aw21024_led symlink.
allow parts_app sysfs_leds:dir search;

# Displayfeature
allow parts_app vendor_hal_displayfeature_service:service_manager find;
binder_call(parts_app, vendor_hal_displayfeature_default)

# Parts (Back light effects, camera status indicator: CameraManager
# availability callbacks need the camera service; the trimmed base
# app_domain does not grant it, so allow explicitly like every app)
allow parts_app cameraserver_service:service_manager find;
binder_call(parts_app, cameraserver)

# Parts (Back light effects: the trimmed base app_domain is also
# missing these everyday finds — media sessions for rhythmic effects,
# audio flinger for the Visualizer, phone for call state)
allow parts_app media_session_service:service_manager find;
allow parts_app audioserver_service:service_manager find;
allow parts_app radio_service:service_manager find;

