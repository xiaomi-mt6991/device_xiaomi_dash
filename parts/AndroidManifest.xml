<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.xiaomi.settings"
    android:versionCode="1"
    android:versionName="1.0"
    android:sharedUserId="android.uid.system">

    <uses-permission android:name="android.permission.INTERACT_ACROSS_USERS_FULL" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.ACCESS_SURFACE_FLINGER" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:label="@string/app_name"
        android:persistent="true"
        android:defaultToDeviceProtectedStorage="true"
        android:directBootAware="true"
        android:theme="@style/Theme.SubSettingsBase.Expressive">

        <receiver
            android:name=".BootCompletedReceiver"
            android:exported="true"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>

        <service
            android:name=".touch.TouchReportRateService"
            android:permission="TouchReportRateService">
        </service>

        <provider
            android:name=".touch.HtsrSwitchProvider"
            android:authorities="com.xiaomi.settings.touch"
            android:exported="true"
            android:grantUriPermissions="false" />

        <service
            android:name=".touch.TouchReportRateTileService"
            android:exported="true"
            android:icon="@drawable/ic_touch_rate"
            android:label="@string/touch_title"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TILE_REQUIRES_UNLOCK"
                android:value="false" />
        </service>

        <service
            android:name=".display.ColorService"
            android:permission="ColorService">
        </service>

        <service
            android:name=".lights.BacklightService"
            android:permission="BacklightService">
        </service>

        <service
            android:name=".lights.BacklightNotificationListener"
            android:exported="true"
            android:label="@string/backlight_title"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <activity
            android:name=".touch.TouchSettingsActivity"
            android:configChanges="orientation|screenSize"
            android:exported="true"
            android:label="@string/touch_title">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.display" />
            <meta-data
                android:name="com.android.settings.order"
                android:value="-10" />
            <meta-data
                android:name="com.android.settings.summary"
                android:value="@string/touch_row_summary" />
            <meta-data
                android:name="com.android.settings.switch_uri"
                android:value="content://com.xiaomi.settings.touch/htsr" />
        </activity>

        <activity
            android:name=".lights.BacklightActivity"
            android:configChanges="orientation|screenSize"
            android:exported="true"
            android:label="@string/backlight_title">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.display" />
            <meta-data
                android:name="com.android.settings.order"
                android:value="-9" />
            <meta-data
                android:name="com.android.settings.summary"
                android:value="@string/backlight_row_summary" />
        </activity>
    </application>
</manifest>

