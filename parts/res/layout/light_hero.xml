<?xml version="1.0" encoding="utf-8"?>
<!--
     Hero header for Back Light Effects (stock parity): device render
     with glowing deco rings. Day/night variant is picked via the
     drawable-night qualifier. Decorative, not clickable. Bound via
     HeroPreference, which sets the asset programmatically.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="8dp"
    android:paddingBottom="16dp">

    <ImageView
        android:id="@+id/hero_image"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_gravity="center"
        android:contentDescription="@null"
        android:scaleType="fitCenter" />

</FrameLayout>
